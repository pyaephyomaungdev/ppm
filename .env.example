# ── Local development ──────────────────────────────────────────
PORT=8787
NODE_ENV=development

# Public site URL (portfolio). Admin is always the same host + /admin/
SITE_URL=http://localhost:5173

# Comma-separated browser origins allowed to call the API with cookies.
# Local: Vite web (:5173) + admin (:5174). Production: only your Railway URL.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

DATABASE_URL=postgresql://ppm:ppm@127.0.0.1:5433/ppm
REDIS_URL=redis://127.0.0.1:6380

SESSION_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false

# Bootstrap admin (seed creates this user if none exists)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# Set to 1 to wipe + re-seed portfolio content (experience, edu, projects, etc.)
# FORCE_SEED_CONTENT=1

# GitHub contribution heatmap
GITHUB_USERNAME=pyaephyomaungdev
GITHUB_TOKEN=

# ── Vite (local only) ──────────────────────────────────────────
# Point SPAs at the API while developing with three processes.
# On Railway: do NOT set VITE_API_BASE — same-origin /api is used
# (portfolio `/` + admin `/admin/` + API `/api` on one host).
# Copy into apps/web/.env and apps/admin/.env as well for local:
#   VITE_API_BASE=http://localhost:8787

# ── Railway (set in dashboard; one service) ─────────────────────
# NODE_ENV=production
# COOKIE_SECURE=true
# SITE_URL=https://YOUR-APP.up.railway.app
# CORS_ORIGIN=https://YOUR-APP.up.railway.app
# DATABASE_URL=  (Postgres plugin)
# REDIS_URL=     (Redis plugin)
# SESSION_SECRET=  (long random)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# GITHUB_USERNAME=pyaephyomaungdev
# GITHUB_TOKEN=
# PORT=          (Railway injects)
# Do not set VITE_API_BASE on Railway.
